{
  "about": "Cases for the website rules, held by the app (test/core/website_rules_test.dart) and by the browser extension's Dart core. Written by hand for the add-cards-identities-and-websites plan (task 6.1) and never regenerated. Unverified until the single build-and-test pass after merging. Each case: match (Bitwarden's UriMatchStrategy number, null for Default), uri (what is saved), address (what the browser shows), fills (whether fillsOn answers true) and phones (the domains phoneDomains gives for a login and for an account holding only that website). An address may be written as addressFill: {repeat, times, then}, repeat joined times over and then followed by then. registrable is what the Public Suffix List says for the hosts that need it; any other host is its own. A host under okta.com, and an IPv4 address, fill on themselves only, whatever the rule.",
  "registrable": {
    "example.co": "example.co",
    "shop.example.co": "example.co",
    "intranet.example.co": "example.co",
    "wiki.example.co": "example.co",
    "accounts.larkspur.example": "larkspur.example",
    "mail.larkspur.example": "larkspur.example",
    "github.example.org": "example.org",
    "gist.example.org": "example.org"
  },
  "cases": [
    {"name": "Default fills on the host", "match": null, "uri": "example.co", "address": "https://example.co/login", "fills": true, "phones": {"login": ["example.co"], "account": ["example.co"]}},
    {"name": "Default fills on a subdomain of the registrable domain", "match": null, "uri": "example.co", "address": "https://shop.example.co/cart", "fills": true, "phones": {"login": ["example.co"], "account": ["example.co"]}},
    {"name": "Default does not fill where the domain is only a label of another host", "match": null, "uri": "example.co", "address": "https://example.co.evil.test/", "fills": false, "phones": {"login": ["example.co"], "account": ["example.co"]}},
    {"name": "Default does not fill on a host that merely ends in the domain", "match": null, "uri": "example.co", "address": "https://evilexample.co/", "fills": false, "phones": {"login": ["example.co"], "account": ["example.co"]}},
    {"name": "Default on a subdomain gives a login its registrable domain and an account the host", "match": null, "uri": "accounts.larkspur.example", "address": "https://mail.larkspur.example/", "fills": true, "phones": {"login": ["larkspur.example"], "account": ["accounts.larkspur.example"]}},
    {"name": "Default on another subdomain of the same organisation", "match": null, "uri": "github.example.org", "address": "https://gist.example.org/", "fills": true, "phones": {"login": ["example.org"], "account": ["github.example.org"]}},
    {"name": "Base domain fills on the whole registrable domain", "match": 0, "uri": "accounts.larkspur.example", "address": "https://mail.larkspur.example/inbox", "fills": true, "phones": {"login": ["larkspur.example"], "account": ["larkspur.example"]}},
    {"name": "Host fills on that host", "match": 1, "uri": "example-co.okta.com", "address": "https://example-co.okta.com/app", "fills": true, "phones": {"login": ["=example-co.okta.com"], "account": ["=example-co.okta.com"]}},
    {"name": "Host does not fill on another tenant", "match": 1, "uri": "example-co.okta.com", "address": "https://other-co.okta.com/app", "fills": false, "phones": {"login": ["=example-co.okta.com"], "account": ["=example-co.okta.com"]}},
    {"name": "Host does not fill on a subdomain", "match": 1, "uri": "example-co.okta.com", "address": "https://sub.example-co.okta.com/", "fills": false, "phones": {"login": ["=example-co.okta.com"], "account": ["=example-co.okta.com"]}},
    {"name": "Base domain on a shared host fills on that host", "match": 0, "uri": "example-co.okta.com", "address": "https://example-co.okta.com/", "fills": true, "phones": {"login": ["=example-co.okta.com"], "account": ["=example-co.okta.com"]}},
    {"name": "Base domain on a shared host does not fill on another tenant", "match": 0, "uri": "example-co.okta.com", "address": "https://other-co.okta.com/", "fills": false, "phones": {"login": ["=example-co.okta.com"], "account": ["=example-co.okta.com"]}},
    {"name": "Default on a shared host fills on that host", "match": null, "uri": "acme.okta.com", "address": "https://acme.okta.com/", "fills": true, "phones": {"login": ["=acme.okta.com"], "account": ["=acme.okta.com"]}},
    {"name": "Default on a shared host does not fill on another tenant", "match": null, "uri": "acme.okta.com", "address": "https://evil.okta.com/", "fills": false, "phones": {"login": ["=acme.okta.com"], "account": ["=acme.okta.com"]}},
    {"name": "An IP address fills on itself", "match": null, "uri": "10.0.0.20", "address": "http://10.0.0.20/login", "fills": true, "phones": {"login": ["=10.0.0.20"], "account": ["=10.0.0.20"]}},
    {"name": "An IP address does not fill on its neighbour", "match": null, "uri": "10.0.0.20", "address": "http://10.0.0.21/login", "fills": false, "phones": {"login": ["=10.0.0.20"], "account": ["=10.0.0.20"]}},
    {"name": "Host with a port fills on that port", "match": 1, "uri": "nas.home.example:5001", "address": "https://nas.home.example:5001/ui", "fills": true, "phones": {"login": ["=nas.home.example"], "account": ["=nas.home.example"]}},
    {"name": "Host with a port does not fill on another port", "match": 1, "uri": "nas.home.example:5001", "address": "https://nas.home.example:8080/", "fills": false, "phones": {"login": ["=nas.home.example"], "account": ["=nas.home.example"]}},
    {"name": "Host with a port does not fill on the default port", "match": 1, "uri": "nas.home.example:5001", "address": "https://nas.home.example/", "fills": false, "phones": {"login": ["=nas.home.example"], "account": ["=nas.home.example"]}},
    {"name": "Host with no port fills on the default port of its scheme", "match": 1, "uri": "nas.home.example", "address": "https://nas.home.example:443/", "fills": true, "phones": {"login": ["=nas.home.example"], "account": ["=nas.home.example"]}},
    {"name": "Starts with fills on a longer address", "match": 2, "uri": "https://intranet.example.co/login", "address": "https://intranet.example.co/login?next=/home", "fills": true, "phones": {"login": ["=intranet.example.co"], "account": ["=intranet.example.co"]}},
    {"name": "Starts with does not fill on another path", "match": 2, "uri": "https://intranet.example.co/login", "address": "https://intranet.example.co/admin", "fills": false, "phones": {"login": ["=intranet.example.co"], "account": ["=intranet.example.co"]}},
    {"name": "Starts with compares scheme and host in lowercase", "match": 2, "uri": "https://intranet.example.co/login", "address": "HTTPS://Intranet.Example.co/login/x", "fills": true, "phones": {"login": ["=intranet.example.co"], "account": ["=intranet.example.co"]}},
    {"name": "Exact fills on that address", "match": 3, "uri": "https://intranet.example.co/home", "address": "https://intranet.example.co/home", "fills": true, "phones": {"login": ["=intranet.example.co"], "account": ["=intranet.example.co"]}},
    {"name": "Exact does not fill with a query added", "match": 3, "uri": "https://intranet.example.co/home", "address": "https://intranet.example.co/home?x=1", "fills": false, "phones": {"login": ["=intranet.example.co"], "account": ["=intranet.example.co"]}},
    {"name": "Exact compares the host in lowercase", "match": 3, "uri": "https://intranet.example.co/home", "address": "https://INTRANET.example.co/home", "fills": true, "phones": {"login": ["=intranet.example.co"], "account": ["=intranet.example.co"]}},
    {"name": "Exact compares the path as written", "match": 3, "uri": "https://intranet.example.co/home", "address": "https://intranet.example.co/Home", "fills": false, "phones": {"login": ["=intranet.example.co"], "account": ["=intranet.example.co"]}},
    {"name": "A regular expression finds a match in the address", "match": 4, "uri": "^https://([a-z]+\\.)?example\\.co/", "address": "https://shop.example.co/cart", "fills": true, "phones": {"login": [], "account": []}},
    {"name": "A regular expression does not match a look-alike host", "match": 4, "uri": "^https://([a-z]+\\.)?example\\.co/", "address": "https://example.co.evil.test/", "fills": false, "phones": {"login": [], "account": []}},
    {"name": "A regular expression ignores case", "match": 4, "uri": "^https://([a-z]+\\.)?example\\.co/", "address": "HTTPS://SHOP.EXAMPLE.CO/", "fills": true, "phones": {"login": [], "account": []}},
    {"name": "A regular expression is a search, not a full match", "match": 4, "uri": "example\\.co/(login|signin)", "address": "https://example.co/signin?x=1", "fills": true, "phones": {"login": [], "account": []}},
    {"name": "A regular expression with a class, a count and an alternative", "match": 4, "uri": "^https://[a-z0-9-]{2,8}\\.(example\\.co|example\\.org)/", "address": "https://shop-1.example.org/", "fills": true, "phones": {"login": [], "account": []}},
    {"name": "A nested repeat answers at once on a long address", "match": 4, "uri": "(a+)+$", "addressFill": {"repeat": "a", "times": 2000, "then": "!"}, "fills": false, "phones": {"login": [], "account": []}},
    {"name": "An address of 2048 characters can match", "match": 4, "uri": "a", "addressFill": {"repeat": "a", "times": 2048, "then": ""}, "fills": true, "phones": {"login": [], "account": []}},
    {"name": "An address over 2048 characters never matches", "match": 4, "uri": "a", "addressFill": {"repeat": "a", "times": 2049, "then": ""}, "fills": false, "phones": {"login": [], "account": []}},
    {"name": "Never fills nowhere", "match": 5, "uri": "wiki.example.co", "address": "https://wiki.example.co/", "fills": false, "phones": {"login": [], "account": []}},
    {"name": "A rule of a later version fills nowhere", "match": 9, "uri": "later.example", "address": "https://later.example/", "fills": false, "phones": {"login": [], "account": []}}
  ]
}
